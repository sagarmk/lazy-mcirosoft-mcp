{
  "name": "lazy-ms-graph-mcp",
  "version": "1.1.0",
  "private": true,
  "description": "Microsoft Graph MCP Server - Access Microsoft 365 from Claude, Cursor, and VS Code",
  "author": "Sagar Mankari",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/server"
  ],
  "scripts": {
